# Convex writes VITE_CONVEX_URL into .env.local automatically when you run
# `npx convex dev`. You normally do NOT set this by hand.
#
# Local anonymous dev (no account) writes something like:
#   VITE_CONVEX_URL=http://127.0.0.1:3210
#
# In production (Cloudflare Pages), `npx convex deploy --cmd 'vite build'` sets
# VITE_CONVEX_URL for the build automatically from your CONVEX_DEPLOY_KEY.
VITE_CONVEX_URL=
