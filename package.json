{
  "name": "convex-party",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-time multiplayer 'rooms' skeleton built on Convex + Vite. Flexible base for a Cursor x Convex hackathon entry.",
  "scripts": {
    "dev": "concurrently -n convex,vite -c green,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "convex dev",
    "dev:frontend": "vite",
    "build": "tsc -b && vite build",
    "deploy": "convex deploy --cmd 'vite build'",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint": "tsc -b --noEmit",
    "qr:dev": "npm --prefix qr run dev",
    "qr:deploy": "npm --prefix qr run deploy",
    "qr:test": "npm --prefix qr test",
    "pages:deploy": "npm run build && wrangler pages deploy dist --project-name=convex-party --branch=main"
  },
  "dependencies": {
    "convex": "^1.27.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "convex-test": "^0.0.37",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
